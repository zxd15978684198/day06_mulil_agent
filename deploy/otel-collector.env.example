# 复制为 deploy/otel-collector.env（已 gitignore），只用于 Collector 进程。
# 应用进程不需要、也不应该持有 Langfuse 密钥。

# Langfuse Cloud EU；自建实例（>= v3.22.0）改成 http://<host>:3000/api/public/otel
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_INGESTION_VERSION=4

# base64(public_key:secret_key)，生成方式：
#   python -c "import base64; print(base64.b64encode(b'pk-lf-xxx:sk-lf-xxx').decode())"
LANGFUSE_AUTH_STRING=
