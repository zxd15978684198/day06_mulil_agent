# =============================================================================
# 虚拟机 / 服务器部署用的 .env 模板
#
#   cp deploy/env.vm.example .env
#   # 然后只改下面标了「必填」的两三行
#
# 这个文件不要提交进 git（.gitignore 已经排除了 .env）。
# =============================================================================

# ---------- 1. 模型：必填 ----------------------------------------------------
# 走 OpenAI 兼容端点。BASE_URL 要能从这台虚拟机访问到（先用 curl 测）。
MODEL_PROVIDER=openai
MODEL_NAME=deepseek-chat
API_KEY=sk-替换成你自己的
BASE_URL=https://api.deepseek.com/v1

# 视觉模型（PNG 办公区地图要它读）。没配的话知识库那条会降级，不影响其他功能。
VISION_MODEL_PROVIDER=openai
VISION_MODEL_NAME=deepseek-chat
VISION_API_KEY=sk-替换成你自己的
VISION_BASE_URL=https://api.deepseek.com/v1

# ---------- 2. Embedding -----------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 权重已经烘进镜像，正常启动不会下载。只有改了 EMBEDDING_MODEL 才会。
HF_ENDPOINT=https://hf-mirror.com

# ---------- 3. 数据库：必须改，别用默认值 ------------------------------------
# 默认值（ChangeMe-Root!）是写在 docker-compose.yml 里的，等于公开。
# 生成强密码：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=换成随机强密码
MYSQL_APP_USER=agent_app
MYSQL_APP_PASSWORD=换成另一条随机强密码
MYSQL_DATABASE=agent_service

# ---------- 4. 端口绑定 ------------------------------------------------------
# 练习阶段：从宿主机浏览器访问虚拟机 IP，必须 0.0.0.0
# 以后挂 nginx/Caddy 做 HTTPS：改成 127.0.0.1，只让反代进来
APP_BIND=0.0.0.0
APP_PORT=8000

# MySQL 端口只绑回环，不对外。要用 Navicat 连就 SSH 隧道：
#   ssh -L 3307:127.0.0.1:3307 用户名@虚拟机IP
MYSQL_BIND=127.0.0.1
MYSQL_HOST_PORT=3307

# ---------- 5. 鉴权：必填 ----------------------------------------------------
# 不配的话登录直接失败。生成：openssl rand -hex 32
JWT_SECRET=换成openssl rand -hex 32的输出
JWT_EXPIRATION=86400

# ---------- 6. 运行期 --------------------------------------------------------
# 下面的 DATABASE_URL 会被 compose 的 environment 覆盖成容器内地址，
# 保留只是为了本机（不经容器）直连数据库时能跑。
DATABASE_URL=mysql+pymysql://agent_app:密码@127.0.0.1:3307/agent_service?charset=utf8mb4
CHECKPOINT_DB=runtime/checkpoints.sqlite3
STREAM_TIMEOUT_SECONDS=120

# ---------- 7. 构建期镜像源（连通性不好时才需要） ----------------------------
# Docker Hub 连不通时启用（注意结尾斜杠）：
# DOCKER_MIRROR=docker.m.daocloud.io/library/
#
# ghcr.io 连不通时启用：
# UV_IMAGE=ghcr.m.daocloud.io/astral-sh/uv:latest
#
# PyPI 慢/超时（uv 会读这个变量）：
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
