# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# 文档只保留在本地：课件与计划不进入版本库（有意为之，不要提交 docs/）
docs

# 环境变量：.env 及其变体一律忽略，模板必须入库
.env
.env.*
!.env.example

# 可观测性：Collector 的 Langfuse 密钥只保留 .example
deploy/otel-collector.env

# 运行期临时目录（见 knowledge_base.ensure_writable_tempdir）
.tmp/

# 本地/CI 生成的测试与覆盖率证据（CI 用 Artifact 保存，不进源码）
reports/
.coverage
.coverage.*
htmlcov/
coverage.xml
pytest-of-*/

# 工具缓存（不能只依赖工具在缓存目录自建的 .gitignore）
.mypy_cache/
.ruff_cache/
.pytest_cache/

# torch inductor 编译缓存（加载 Embedding 模型时自动生成）
torchinductor_*/

# 状态持久化运行期产物：LangGraph 检查点 SQLite 与 runall 目录
# （见 docs/plans/状态持久化升级计划.md 步骤 S0）
runtime/
*.sqlite3
*.sqlite3-*

# 向量索引由 build_index.py 重新生成（含二进制与 chroma.sqlite3），不入库
src/vector_store/

# IDE / 操作系统 / 日志
.idea/
.vscode/
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log
logs/

# 前端依赖兜底（frontend/.gitignore 已覆盖大部分）
node_modules/
