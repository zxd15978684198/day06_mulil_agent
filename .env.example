MODEL_PROVIDER=openai
MODEL_NAME=<支持 Tool Calling 的模型名称>
API_KEY=<不要提交的真实密钥>
BASE_URL=<服务端点>

# 多模态（导览图、海报）单独一个接口：建库时把图片转成可检索的文字说明。
# 推荐用原生多模态模型，例如 GLM-5.3-Flash（model id: glm-5.3-flash）。
# VISION_MODEL_PROVIDER / VISION_MODEL_NAME 都不填时，回落到上面的聊天模型，
# index_manifest.json 会记 config_source=vision_fallback。
# VISION_API_KEY / VISION_BASE_URL 留空则分别回落用 API_KEY / BASE_URL。
VISION_MODEL_PROVIDER=openai
VISION_MODEL_NAME=<原生多模态模型名称，如 glm-5.3-flash>
VISION_API_KEY=
VISION_BASE_URL=

# 使用本地 Hugging Face Embedding
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 可选：若 huggingface.co 不可达，取消下一行注释改用 HF 镜像
# HF_ENDPOINT=https://hf-mirror.com

# 状态持久化（Week16 Day05）：业务数据落 MySQL，LangGraph 会话检查点落 SQLite。
# 表结构由 scripts/day05_mysql_setup.sql 一次性初始化（会建库 agent_service、
# 建账号 agent_app 并只授予 SELECT/INSERT/UPDATE/DELETE）。
# 密码要与那份 SQL 里的 CREATE USER / ALTER USER 保持一致。
DATABASE_URL=mysql+pymysql://agent_app:<与 SQL 中一致的密码>@127.0.0.1:3306/agent_service?charset=utf8mb4

# 会话检查点文件（相对路径由 src/personal_assistant/paths.py 解析成项目内绝对路径）
CHECKPOINT_DB=runtime/checkpoints.sqlite3

# 单个 SSE 流的最长运行时间（秒）。一次带工具调用的写操作要跑 2~3 轮模型调用，
# 实测 11s~130s；设太小会把正常请求掐断（超时后本轮被取消，用户必须重发消息）。
STREAM_TIMEOUT_SECONDS=300

# JWT 签名密钥。src/personal_assistant/auth.py 会检查：至少 32 字节，
# 且不能是 <...> 占位符，否则登录接口直接抛错。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<至少 32 字节的随机串>
JWT_EXPIRATION=60

# ---------------------------------------------------------------------------
# 可观测性（OpenTelemetry）—— 默认关闭
# ---------------------------------------------------------------------------
# 不设置 OTEL_EXPORTER_OTLP_ENDPOINT、也不选 console 时，应用完全 no-op：
# 不创建 Provider、不启动后台导出线程，业务和测试不受影响。
# 本地只想在终端看 Trace：OTEL_TRACES_EXPORTER=console
OTEL_SERVICE_NAME=employee-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
# 日志走 stdout + Grafana Alloy -> Loki，不引入 OTel Logs SDK
OTEL_LOGS_EXPORTER=none
# 本地 parentbased_traceidratio=1.0；生产可让 Collector 尾采样
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=5000
# 自动插桩默认不采集 Prompt / 回答 / 工具入参
OPENINFERENCE_HIDE_INPUTS=true
OPENINFERENCE_HIDE_OUTPUTS=true
DEPLOYMENT_ENV=development
# Collector 需要认证时再填；Langfuse 密钥只放 Collector，不要放这里
# OTEL_EXPORTER_OTLP_HEADERS=
# 本地开发可排除静态资源/健康检查
# OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/static/.*

# ---------------------------------------------------------------------------
# Docker Compose 专用（见 docker-compose.yml 与 docs/指导文档/Docker部署.md）
# 用 `uv run` 在本机直接跑时这几项用不到；不填就走 compose 里的默认值。
# ---------------------------------------------------------------------------

# MySQL 容器（compose 服务名 mysql）的管理员口令与应用账号口令。
# 应用账号只有 SELECT/INSERT/UPDATE/DELETE —— 与 scripts/day05_mysql_setup.sql 的设计一致。
# 「建应用账号 + 登记 alembic 账本」由 db-init 服务用管理员口令完成，
# 应用容器拿不到管理员口令。
MYSQL_ROOT_PASSWORD=<随机口令>
MYSQL_APP_USER=agent_app
MYSQL_APP_PASSWORD=<随机口令>
MYSQL_DATABASE=agent_service

# 换服务器部署时要设的两个（不设就走 Docker Hub / 默认端口）。
# 国内服务器直连不通 registry-1.docker.io，构建第一步就会
# `Head "https://registry-1.docker.io/v2/...": EOF`。设了镜像站即可，
# 不用改 Dockerfile。注意结尾的斜杠别漏。
# DOCKER_MIRROR=docker.m.daocloud.io/library/
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.4

# 监听地址与端口。
#   MYSQL_BIND  —— MySQL 只绑宿主机回环地址。应用走 compose 内部网络直连
#                  mysql:3306，用不到这个映射；留着是为了能 SSH 隧道连进去。
#                  绝对不要改成 0.0.0.0。
#   APP_BIND    —— 服务器上默认 0.0.0.0（要能被外网访问）。
#                  前面挂 nginx/Caddy 做 HTTPS 就改成 127.0.0.1。
MYSQL_BIND=127.0.0.1
MYSQL_HOST_PORT=3307
APP_BIND=0.0.0.0
APP_PORT=8000
